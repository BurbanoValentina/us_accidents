{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/FRONTEND",
      "destination": "/index.html"
    },
    {
      "source": "/FRONTEND/",
      "destination": "/index.html"
    },
    {
      "source": "/FRONTEND/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/FRONTEND/assets/(.*)",
      "destination": "/assets/$1"
    }
  ]
}
